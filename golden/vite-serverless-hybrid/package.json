{
  "name": "golden-vite-serverless-hybrid",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run tests/app.unit.test.ts",
    "test:coverage": "vitest run --coverage tests/app.unit.test.ts tests/api.unit.test.ts tests/api.guards.test.ts tests/api.loopback.test.ts",
    "test:api": "vitest run tests/api.unit.test.ts tests/api.loopback.test.ts",
    "test:api-guards": "vitest run tests/api.guards.test.ts",
    "test:e2e": "playwright test",
    "test:production-boundary": "vitest run --config vitest.production.config.ts"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "15.15.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.4",
    "vitest": "4.1.0"
  }
}
