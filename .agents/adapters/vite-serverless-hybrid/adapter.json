{
  "$schema": "../../schemas/web-core/adapter.schema.json",
  "schemaVersion": 1,
  "id": "vite-serverless-hybrid",
  "version": "1.1.0",
  "supportLevel": "compatible",
  "trust": {
    "tier": "builtin",
    "source": "web-harness-control-plane",
    "commandPolicy": "argv-only",
    "allowedExecutables": [
      "pnpm"
    ],
    "environmentAllowlist": [
      "CI",
      "NODE_ENV"
    ]
  },
  "project": {
    "framework": "react",
    "variant": "vite-serverless-hybrid",
    "packageManager": "pnpm",
    "router": "react-router",
    "rendering": [
      "csr"
    ]
  },
  "runtime": {
    "primary": "browser",
    "supported": [
      "browser",
      "node",
      "node-build"
    ]
  },
  "detection": {
    "allPackages": [
      "react",
      "vite"
    ],
    "anyPackages": [],
    "allPaths": [
      "api"
    ],
    "anyPaths": [
      "vite.config.js",
      "vite.config.mjs",
      "vite.config.ts",
      "src/main.jsx",
      "src/main.tsx"
    ],
    "forbiddenPackages": [
      "next"
    ],
    "forbiddenPaths": []
  },
  "profileDefaults": {
    "productKind": "hybrid-web",
    "backendShape": "serverless-functions",
    "deploymentProvider": "vercel",
    "deploymentTarget": "vercel-hybrid",
    "riskLevel": "authenticated-business",
    "capabilities": [
      "client-routing",
      "csr",
      "serverless-functions",
      "static-build"
    ]
  },
  "provides": [
    "auth",
    "client-routing",
    "cookie-auth",
    "csr",
    "external-ingestion",
    "scheduled-static-ingestion",
    "serverless-functions",
    "static-build"
  ],
  "conflicts": [
    "rsc",
    "server-actions",
    "ssr"
  ],
  "deploymentProviders": [
    {
      "id": "vercel",
      "deploymentTargets": [
        "vercel-hybrid"
      ]
    }
  ],
  "deploymentTargets": [
    {
      "id": "vercel-hybrid",
      "runtime": "node",
      "requires": [
        "serverless-functions",
        "static-build"
      ],
      "conflicts": [
        "rsc",
        "server-actions",
        "ssr"
      ]
    }
  ],
  "artifacts": [
    {
      "id": "vite-dist",
      "path": "dist",
      "kind": "static-directory",
      "deploymentTargets": [
        "vercel-hybrid"
      ]
    }
  ],
  "commands": [
    {
      "id": "dependencies.install",
      "executable": "pnpm",
      "args": [
        "install",
        "--frozen-lockfile",
        "--ignore-scripts"
      ],
      "cwd": "."
    },
    {
      "id": "quality.lint",
      "executable": "pnpm",
      "args": [
        "run",
        "lint"
      ],
      "cwd": "."
    },
    {
      "id": "quality.typecheck",
      "executable": "pnpm",
      "args": [
        "run",
        "typecheck"
      ],
      "cwd": "."
    },
    {
      "id": "quality.unit",
      "executable": "pnpm",
      "args": [
        "run",
        "test"
      ],
      "cwd": "."
    },
    {
      "id": "ingestion.validate",
      "executable": "pnpm",
      "args": [
        "run",
        "validate:ingestion"
      ],
      "cwd": "."
    },
    {
      "id": "api.unit",
      "executable": "pnpm",
      "args": [
        "run",
        "test:api"
      ],
      "cwd": "."
    },
    {
      "id": "api.guards",
      "executable": "pnpm",
      "args": [
        "run",
        "test:api-guards"
      ],
      "cwd": "."
    },
    {
      "id": "vite.build",
      "executable": "pnpm",
      "args": [
        "run",
        "build"
      ],
      "cwd": "."
    },
    {
      "id": "vite.browser",
      "executable": "pnpm",
      "args": [
        "run",
        "test:e2e"
      ],
      "cwd": "."
    },
    {
      "id": "vite.production-mock-boundary",
      "executable": "pnpm",
      "args": [
        "run",
        "test:production-boundary"
      ],
      "cwd": "."
    }
  ],
  "checks": [
    {
      "id": "quality.lint",
      "kind": "static",
      "commandId": "quality.lint",
      "requires": [],
      "evidenceCapability": "evidence.lint"
    },
    {
      "id": "quality.typecheck",
      "kind": "static",
      "commandId": "quality.typecheck",
      "requires": [],
      "evidenceCapability": "evidence.typecheck"
    },
    {
      "id": "quality.unit",
      "kind": "unit",
      "commandId": "quality.unit",
      "requires": [],
      "evidenceCapability": "evidence.unit"
    },
    {
      "id": "ingestion.validate",
      "kind": "contract",
      "commandId": "ingestion.validate",
      "requires": [
        "external-ingestion"
      ],
      "evidenceCapability": "evidence.ingestion"
    },
    {
      "id": "api.unit",
      "kind": "unit",
      "commandId": "api.unit",
      "requires": [
        "serverless-functions"
      ],
      "evidenceCapability": "evidence.api-unit"
    },
    {
      "id": "api.guards",
      "kind": "security",
      "commandId": "api.guards",
      "requires": [
        "serverless-functions"
      ],
      "evidenceCapability": "evidence.api-guards"
    },
    {
      "id": "vite.build",
      "kind": "build",
      "commandId": "vite.build",
      "requires": [],
      "evidenceCapability": "artifact.built"
    },
    {
      "id": "vite.browser",
      "kind": "browser",
      "commandId": "vite.browser",
      "requires": [
        "client-routing"
      ],
      "evidenceCapability": "evidence.browser"
    },
    {
      "id": "vite.production-mock-boundary",
      "kind": "security",
      "commandId": "vite.production-mock-boundary",
      "requires": [
        "static-build"
      ],
      "evidenceCapability": "evidence.production-boundary"
    }
  ],
  "initialCapabilities": [
    "requirements.locked"
  ],
  "targetCapabilities": [
    "release.candidate"
  ],
  "tasks": [
    {
      "id": "core.resolve-profile",
      "phase": "plan",
      "requires": [
        "requirements.locked"
      ],
      "provides": [
        "profile.resolved"
      ],
      "commandIds": []
    },
    {
      "id": "adapter.scaffold",
      "phase": "scaffold",
      "requires": [
        "profile.resolved"
      ],
      "provides": [
        "source.ready"
      ],
      "commandIds": []
    },
    {
      "id": "dependencies.install",
      "phase": "install",
      "requires": [
        "source.ready"
      ],
      "provides": [
        "dependencies.installed"
      ],
      "commandIds": [
        "dependencies.install"
      ]
    },
    {
      "id": "quality.lint",
      "phase": "verify",
      "requires": [
        "dependencies.installed"
      ],
      "provides": [
        "evidence.lint"
      ],
      "commandIds": [
        "quality.lint"
      ]
    },
    {
      "id": "quality.typecheck",
      "phase": "verify",
      "requires": [
        "dependencies.installed"
      ],
      "provides": [
        "evidence.typecheck"
      ],
      "commandIds": [
        "quality.typecheck"
      ]
    },
    {
      "id": "quality.unit",
      "phase": "verify",
      "requires": [
        "dependencies.installed"
      ],
      "provides": [
        "evidence.unit"
      ],
      "commandIds": [
        "quality.unit"
      ]
    },
    {
      "id": "ingestion.validate",
      "phase": "verify",
      "requires": [
        "dependencies.installed"
      ],
      "provides": [
        "evidence.ingestion"
      ],
      "commandIds": [
        "ingestion.validate"
      ]
    },
    {
      "id": "api.unit",
      "phase": "verify",
      "requires": [
        "dependencies.installed"
      ],
      "provides": [
        "evidence.api-unit"
      ],
      "commandIds": [
        "api.unit"
      ]
    },
    {
      "id": "api.guards",
      "phase": "verify",
      "requires": [
        "dependencies.installed"
      ],
      "provides": [
        "evidence.api-guards"
      ],
      "commandIds": [
        "api.guards"
      ]
    },
    {
      "id": "vite.build",
      "phase": "build",
      "requires": [
        "dependencies.installed",
        "evidence.typecheck"
      ],
      "provides": [
        "artifact.built"
      ],
      "commandIds": [
        "vite.build"
      ]
    },
    {
      "id": "vite.production-boundary",
      "phase": "verify",
      "requires": [
        "artifact.built"
      ],
      "provides": [
        "evidence.production-boundary"
      ],
      "commandIds": [
        "vite.production-mock-boundary"
      ]
    },
    {
      "id": "vite.browser",
      "phase": "runtime",
      "requires": [
        "artifact.built"
      ],
      "provides": [
        "evidence.browser"
      ],
      "commandIds": [
        "vite.browser"
      ]
    },
    {
      "id": "release.assemble",
      "phase": "release",
      "requires": [
        "evidence.api-guards",
        "evidence.api-unit",
        "evidence.browser",
        "evidence.lint",
        "evidence.production-boundary",
        "evidence.unit"
      ],
      "provides": [
        "release.candidate",
        "release.vercel-hybrid"
      ],
      "commandIds": []
    }
  ]
}
