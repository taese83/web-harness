{
  "$schema": "../../schemas/web-core/adapter.schema.json",
  "schemaVersion": 1,
  "id": "next-app-fullstack",
  "version": "1.1.0",
  "supportLevel": "compatible",
  "trust": {
    "tier": "builtin",
    "source": "web-harness-control-plane",
    "commandPolicy": "argv-only",
    "allowedExecutables": [
      "pnpm"
    ],
    "environmentAllowlist": [
      "CI",
      "NODE_ENV",
      "NEXT_TELEMETRY_DISABLED"
    ]
  },
  "project": {
    "framework": "next",
    "variant": "app-fullstack",
    "packageManager": "pnpm",
    "router": "app",
    "rendering": [
      "isr",
      "rsc",
      "ssg",
      "ssr",
      "streaming"
    ]
  },
  "runtime": {
    "primary": "node",
    "supported": [
      "browser",
      "container",
      "node",
      "node-build",
      "static-export"
    ]
  },
  "detection": {
    "allPackages": [
      "next",
      "react"
    ],
    "anyPackages": [],
    "allPaths": [],
    "anyPaths": [
      "app",
      "src/app"
    ],
    "forbiddenPackages": [],
    "forbiddenPaths": [
      "pages",
      "src/pages",
      "server.cjs",
      "server.js",
      "server.mjs",
      "server.ts"
    ]
  },
  "profileDefaults": {
    "productKind": "full-stack-web",
    "backendShape": "framework-integrated",
    "deploymentProvider": "generic",
    "deploymentTarget": "node-server",
    "riskLevel": "authenticated-business",
    "capabilities": [
      "app-router",
      "rsc",
      "ssg",
      "ssr",
      "streaming"
    ]
  },
  "provides": [
    "app-router",
    "auth",
    "bff",
    "cookie-auth",
    "dynamic-route",
    "external-ingestion",
    "isr",
    "route-handler-mutation",
    "route-handlers",
    "rsc",
    "scheduled-static-ingestion",
    "server-actions",
    "ssg",
    "ssr",
    "static-get-route-handler",
    "streaming"
  ],
  "conflicts": [
    "pages-router",
    "edge-runtime"
  ],
  "deploymentProviders": [
    {
      "id": "generic",
      "deploymentTargets": [
        "docker-standalone",
        "node-server",
        "static-export"
      ]
    },
    {
      "id": "vercel",
      "deploymentTargets": [
        "node-server",
        "static-export"
      ]
    }
  ],
  "deploymentTargets": [
    {
      "id": "node-server",
      "runtime": "node",
      "requires": [
        "ssr"
      ],
      "conflicts": [
        "edge-runtime"
      ]
    },
    {
      "id": "docker-standalone",
      "runtime": "container",
      "requires": [
        "ssr"
      ],
      "conflicts": [
        "edge-runtime"
      ]
    },
    {
      "id": "static-export",
      "runtime": "browser",
      "requires": [
        "ssg"
      ],
      "conflicts": [
        "auth",
        "bff",
        "cookie-auth",
        "isr",
        "route-handler-mutation",
        "server-actions",
        "ssr"
      ]
    }
  ],
  "artifacts": [
    {
      "id": "next-build",
      "path": ".next",
      "kind": "framework-build-directory",
      "deploymentTargets": [
        "docker-standalone",
        "node-server"
      ]
    },
    {
      "id": "next-standalone",
      "path": ".next/standalone",
      "kind": "node-standalone-directory",
      "deploymentTargets": [
        "docker-standalone"
      ]
    },
    {
      "id": "next-static-export",
      "path": "out",
      "kind": "static-directory",
      "deploymentTargets": [
        "static-export"
      ]
    }
  ],
  "initialCapabilities": [
    "requirements.locked"
  ],
  "targetCapabilities": [
    "release.candidate"
  ],
  "shapes": [
    "ssr-web-app"
  ]
}
