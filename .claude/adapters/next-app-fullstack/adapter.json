{
  "$schema": "../../schemas/web-core/adapter.schema.json",
  "schemaVersion": 1,
  "id": "next-app-fullstack",
  "version": "1.1.0",
  "supportLevel": "compatible",
  "trust": {
    "tier": "builtin",
    "source": "web-harness-control-plane",
    "commandPolicy": "argv-only",
    "allowedExecutables": ["pnpm"],
    "environmentAllowlist": ["CI", "NODE_ENV", "NEXT_TELEMETRY_DISABLED"]
  },
  "project": {
    "framework": "next",
    "variant": "app-fullstack",
    "packageManager": "pnpm",
    "router": "app",
    "rendering": ["isr", "rsc", "ssg", "ssr", "streaming"]
  },
  "runtime": {
    "primary": "node",
    "supported": ["browser", "container", "node", "node-build", "static-export"]
  },
  "detection": {
    "allPackages": ["next", "react"],
    "anyPackages": [],
    "allPaths": [],
    "anyPaths": ["app", "src/app"],
    "forbiddenPackages": [],
    "forbiddenPaths": ["pages", "src/pages", "server.cjs", "server.js", "server.mjs", "server.ts"]
  },
  "profileDefaults": {
    "productKind": "full-stack-web",
    "backendShape": "framework-integrated",
    "deploymentProvider": "generic",
    "deploymentTarget": "node-server",
    "riskLevel": "authenticated-business",
    "capabilities": ["app-router", "rsc", "ssg", "ssr", "streaming"]
  },
  "provides": ["app-router", "auth", "bff", "cookie-auth", "dynamic-route", "external-ingestion", "isr", "route-handler-mutation", "route-handlers", "rsc", "scheduled-static-ingestion", "server-actions", "ssg", "ssr", "static-get-route-handler", "streaming"],
  "conflicts": ["pages-router", "edge-runtime"],
  "deploymentProviders": [
    {"id": "generic", "deploymentTargets": ["docker-standalone", "node-server", "static-export"]},
    {"id": "vercel", "deploymentTargets": ["node-server", "static-export"]}
  ],
  "deploymentTargets": [
    {"id": "node-server", "runtime": "node", "requires": ["ssr"], "conflicts": ["edge-runtime"]},
    {"id": "docker-standalone", "runtime": "container", "requires": ["ssr"], "conflicts": ["edge-runtime"]},
    {"id": "static-export", "runtime": "browser", "requires": ["ssg"], "conflicts": ["auth", "bff", "cookie-auth", "isr", "route-handler-mutation", "server-actions", "ssr"]}
  ],
  "artifacts": [
    {"id": "next-build", "path": ".next", "kind": "framework-build-directory", "deploymentTargets": ["docker-standalone", "node-server"]},
    {"id": "next-standalone", "path": ".next/standalone", "kind": "node-standalone-directory", "deploymentTargets": ["docker-standalone"]},
    {"id": "next-static-export", "path": "out", "kind": "static-directory", "deploymentTargets": ["static-export"]}
  ],
  "commands": [
    {"id": "dependencies.install", "executable": "pnpm", "args": ["install", "--frozen-lockfile", "--ignore-scripts"], "cwd": "."},
    {"id": "quality.lint", "executable": "pnpm", "args": ["run", "lint"], "cwd": "."},
    {"id": "quality.typecheck", "executable": "pnpm", "args": ["run", "typecheck"], "cwd": "."},
    {"id": "quality.unit", "executable": "pnpm", "args": ["run", "test"], "cwd": "."},
    {"id": "ingestion.validate", "executable": "pnpm", "args": ["run", "validate:ingestion"], "cwd": "."},
    {"id": "next.build", "executable": "pnpm", "args": ["run", "build"], "cwd": "."},
    {"id": "next.route-contract", "executable": "pnpm", "args": ["run", "test:routes"], "cwd": "."},
    {"id": "next.client-boundary", "executable": "pnpm", "args": ["run", "test:client-boundary"], "cwd": "."},
    {"id": "next.secret-boundary", "executable": "pnpm", "args": ["run", "test:secret-boundary"], "cwd": "."},
    {"id": "next.production-start", "executable": "pnpm", "args": ["run", "test:production-start"], "cwd": "."},
    {"id": "next.node-browser", "executable": "pnpm", "args": ["run", "test:e2e:node"], "cwd": "."},
    {"id": "next.node-hydration", "executable": "pnpm", "args": ["run", "test:hydration:node"], "cwd": "."},
    {"id": "next.node-authz", "executable": "pnpm", "args": ["run", "test:authz:node"], "cwd": "."},
    {"id": "next.node-cache-isolation", "executable": "pnpm", "args": ["run", "test:cache-isolation:node"], "cwd": "."},
    {"id": "next.node-smoke", "executable": "pnpm", "args": ["run", "test:node-smoke"], "cwd": "."},
    {"id": "next.node-shutdown", "executable": "pnpm", "args": ["run", "test:shutdown:node"], "cwd": "."},
    {"id": "next.docker-build", "executable": "pnpm", "args": ["run", "test:docker-build"], "cwd": "."},
    {"id": "next.docker-smoke", "executable": "pnpm", "args": ["run", "test:docker-smoke"], "cwd": "."},
    {"id": "next.docker-browser", "executable": "pnpm", "args": ["run", "test:e2e:docker"], "cwd": "."},
    {"id": "next.docker-hydration", "executable": "pnpm", "args": ["run", "test:hydration:docker"], "cwd": "."},
    {"id": "next.docker-authz", "executable": "pnpm", "args": ["run", "test:authz:docker"], "cwd": "."},
    {"id": "next.docker-cache-isolation", "executable": "pnpm", "args": ["run", "test:cache-isolation:docker"], "cwd": "."},
    {"id": "next.docker-shutdown", "executable": "pnpm", "args": ["run", "test:shutdown:docker"], "cwd": "."},
    {"id": "next.export-artifact", "executable": "pnpm", "args": ["run", "test:export-artifact"], "cwd": "."},
    {"id": "next.static-host-smoke", "executable": "pnpm", "args": ["run", "test:static-host-smoke"], "cwd": "."},
    {"id": "next.static-browser", "executable": "pnpm", "args": ["run", "test:e2e:static"], "cwd": "."},
    {"id": "next.static-hydration", "executable": "pnpm", "args": ["run", "test:hydration:static"], "cwd": "."}
  ],
  "checks": [
    {"id": "quality.lint", "kind": "static", "commandId": "quality.lint", "requires": [], "evidenceCapability": "evidence.lint"},
    {"id": "quality.typecheck", "kind": "static", "commandId": "quality.typecheck", "requires": [], "evidenceCapability": "evidence.typecheck"},
    {"id": "quality.unit", "kind": "unit", "commandId": "quality.unit", "requires": [], "evidenceCapability": "evidence.unit"},
    {"id": "ingestion.validate", "kind": "contract", "commandId": "ingestion.validate", "requires": ["external-ingestion"], "evidenceCapability": "evidence.ingestion"},
    {"id": "next.build", "kind": "build", "commandId": "next.build", "requires": [], "evidenceCapability": "artifact.built"},
    {"id": "next.route-contract", "kind": "contract", "commandId": "next.route-contract", "requires": ["app-router"], "evidenceCapability": "evidence.next.route-contract"},
    {"id": "next.client-boundary", "kind": "security", "commandId": "next.client-boundary", "requires": ["rsc"], "evidenceCapability": "evidence.next.client-boundary"},
    {"id": "next.secret-boundary", "kind": "security", "commandId": "next.secret-boundary", "requires": ["rsc"], "evidenceCapability": "evidence.next.secret-boundary"},
    {"id": "next.production-start", "kind": "runtime", "commandId": "next.production-start", "requires": ["node-server", "ssr"], "evidenceCapability": "evidence.next.production-start"},
    {"id": "next.node-browser", "kind": "browser", "commandId": "next.node-browser", "requires": ["node-server", "app-router"], "evidenceCapability": "evidence.next.node-browser"},
    {"id": "next.node-hydration", "kind": "browser", "commandId": "next.node-hydration", "requires": ["node-server", "rsc"], "evidenceCapability": "evidence.next.node-hydration"},
    {"id": "next.node-authz", "kind": "security", "commandId": "next.node-authz", "requires": ["node-server", "auth"], "evidenceCapability": "evidence.next.node-authz"},
    {"id": "next.node-cache-isolation", "kind": "security", "commandId": "next.node-cache-isolation", "requires": ["node-server", "auth"], "evidenceCapability": "evidence.next.node-cache-isolation"},
    {"id": "next.node-smoke", "kind": "runtime", "commandId": "next.node-smoke", "requires": ["node-server"], "evidenceCapability": "evidence.next.node-smoke"},
    {"id": "next.node-shutdown", "kind": "runtime", "commandId": "next.node-shutdown", "requires": ["node-server"], "evidenceCapability": "evidence.next.node-shutdown"},
    {"id": "next.docker-build", "kind": "artifact", "commandId": "next.docker-build", "requires": ["docker-standalone"], "evidenceCapability": "artifact.next.docker"},
    {"id": "next.docker-smoke", "kind": "runtime", "commandId": "next.docker-smoke", "requires": ["docker-standalone"], "evidenceCapability": "evidence.next.docker-smoke"},
    {"id": "next.docker-browser", "kind": "browser", "commandId": "next.docker-browser", "requires": ["docker-standalone", "app-router"], "evidenceCapability": "evidence.next.docker-browser"},
    {"id": "next.docker-hydration", "kind": "browser", "commandId": "next.docker-hydration", "requires": ["docker-standalone", "rsc"], "evidenceCapability": "evidence.next.docker-hydration"},
    {"id": "next.docker-authz", "kind": "security", "commandId": "next.docker-authz", "requires": ["docker-standalone", "auth"], "evidenceCapability": "evidence.next.docker-authz"},
    {"id": "next.docker-cache-isolation", "kind": "security", "commandId": "next.docker-cache-isolation", "requires": ["docker-standalone", "auth"], "evidenceCapability": "evidence.next.docker-cache-isolation"},
    {"id": "next.docker-shutdown", "kind": "runtime", "commandId": "next.docker-shutdown", "requires": ["docker-standalone"], "evidenceCapability": "evidence.next.docker-shutdown"},
    {"id": "next.export-artifact", "kind": "artifact", "commandId": "next.export-artifact", "requires": ["static-export"], "evidenceCapability": "artifact.next.static-export"},
    {"id": "next.static-host-smoke", "kind": "runtime", "commandId": "next.static-host-smoke", "requires": ["static-export"], "evidenceCapability": "evidence.next.static-host-smoke"},
    {"id": "next.static-browser", "kind": "browser", "commandId": "next.static-browser", "requires": ["static-export", "app-router"], "evidenceCapability": "evidence.next.static-browser"},
    {"id": "next.static-hydration", "kind": "browser", "commandId": "next.static-hydration", "requires": ["static-export", "rsc"], "evidenceCapability": "evidence.next.static-hydration"}
  ],
  "initialCapabilities": ["requirements.locked"],
  "targetCapabilities": ["release.candidate"],
  "tasks": [
    {"id": "core.resolve-profile", "phase": "plan", "requires": ["requirements.locked"], "provides": ["profile.resolved"], "commandIds": []},
    {"id": "adapter.scaffold", "phase": "scaffold", "requires": ["profile.resolved"], "provides": ["source.ready"], "commandIds": []},
    {"id": "dependencies.install", "phase": "install", "requires": ["source.ready"], "provides": ["dependencies.installed"], "commandIds": ["dependencies.install"]},
    {"id": "quality.lint", "phase": "verify", "requires": ["dependencies.installed"], "provides": ["evidence.lint"], "commandIds": ["quality.lint"]},
    {"id": "quality.typecheck", "phase": "verify", "requires": ["dependencies.installed"], "provides": ["evidence.typecheck"], "commandIds": ["quality.typecheck"]},
    {"id": "quality.unit", "phase": "verify", "requires": ["dependencies.installed"], "provides": ["evidence.unit"], "commandIds": ["quality.unit"]},
    {"id": "ingestion.validate", "phase": "verify", "requires": ["dependencies.installed"], "provides": ["evidence.ingestion"], "commandIds": ["ingestion.validate"]},
    {"id": "next.build", "phase": "build", "requires": ["dependencies.installed", "evidence.typecheck"], "provides": ["artifact.built"], "commandIds": ["next.build"]},
    {"id": "next.route-contract", "phase": "verify", "requires": ["artifact.built"], "provides": ["evidence.next.route-contract"], "commandIds": ["next.route-contract"]},
    {"id": "next.client-boundary", "phase": "verify", "requires": ["artifact.built"], "provides": ["evidence.next.client-boundary"], "commandIds": ["next.client-boundary"]},
    {"id": "next.secret-boundary", "phase": "verify", "requires": ["artifact.built"], "provides": ["evidence.next.secret-boundary"], "commandIds": ["next.secret-boundary"]},
    {"id": "next.production-start", "phase": "runtime", "requires": ["artifact.built"], "provides": ["evidence.next.production-start"], "commandIds": ["next.production-start"]},
    {"id": "next.node-browser", "phase": "runtime", "requires": ["artifact.built"], "provides": ["evidence.next.node-browser"], "commandIds": ["next.node-browser"]},
    {"id": "next.node-hydration", "phase": "runtime", "requires": ["artifact.built"], "provides": ["evidence.next.node-hydration"], "commandIds": ["next.node-hydration"]},
    {"id": "next.node-smoke", "phase": "runtime", "requires": ["artifact.built"], "provides": ["evidence.next.node-smoke"], "commandIds": ["next.node-smoke"]},
    {"id": "next.node-shutdown", "phase": "runtime", "requires": ["artifact.built"], "provides": ["evidence.next.node-shutdown"], "commandIds": ["next.node-shutdown"]},
    {"id": "next.node-authz", "phase": "verify", "requires": ["artifact.built"], "provides": ["evidence.next.node-authz"], "commandIds": ["next.node-authz"]},
    {"id": "next.node-cache-isolation", "phase": "runtime", "requires": ["artifact.built"], "provides": ["evidence.next.node-cache-isolation"], "commandIds": ["next.node-cache-isolation"]},
    {"id": "release.assemble", "phase": "release", "requires": ["evidence.lint", "evidence.next.client-boundary", "evidence.next.node-browser", "evidence.next.node-hydration", "evidence.next.production-start", "evidence.next.route-contract", "evidence.next.secret-boundary", "evidence.next.node-shutdown", "evidence.unit"], "provides": ["release.candidate", "release.node-server"], "commandIds": []},
    {"id": "next.docker-build", "phase": "build", "requires": ["artifact.built"], "provides": ["artifact.next.docker"], "commandIds": ["next.docker-build"]},
    {"id": "next.docker-smoke", "phase": "runtime", "requires": ["artifact.next.docker"], "provides": ["evidence.next.docker-smoke"], "commandIds": ["next.docker-smoke"]},
    {"id": "next.docker-browser", "phase": "runtime", "requires": ["artifact.next.docker"], "provides": ["evidence.next.docker-browser"], "commandIds": ["next.docker-browser"]},
    {"id": "next.docker-hydration", "phase": "runtime", "requires": ["artifact.next.docker"], "provides": ["evidence.next.docker-hydration"], "commandIds": ["next.docker-hydration"]},
    {"id": "next.docker-authz", "phase": "runtime", "requires": ["artifact.next.docker"], "provides": ["evidence.next.docker-authz"], "commandIds": ["next.docker-authz"]},
    {"id": "next.docker-cache-isolation", "phase": "runtime", "requires": ["artifact.next.docker"], "provides": ["evidence.next.docker-cache-isolation"], "commandIds": ["next.docker-cache-isolation"]},
    {"id": "next.docker-shutdown", "phase": "runtime", "requires": ["artifact.next.docker"], "provides": ["evidence.next.docker-shutdown"], "commandIds": ["next.docker-shutdown"]},
    {"id": "release.docker-standalone", "phase": "release", "requires": ["evidence.lint", "evidence.next.client-boundary", "evidence.next.docker-browser", "evidence.next.docker-hydration", "evidence.next.docker-shutdown", "evidence.next.route-contract", "evidence.next.secret-boundary", "evidence.unit"], "provides": ["release.docker-standalone"], "commandIds": []},
    {"id": "next.export-artifact", "phase": "build", "requires": ["artifact.built"], "provides": ["artifact.next.static-export"], "commandIds": ["next.export-artifact"]},
    {"id": "next.static-host-smoke", "phase": "runtime", "requires": ["artifact.next.static-export"], "provides": ["evidence.next.static-host-smoke"], "commandIds": ["next.static-host-smoke"]},
    {"id": "next.static-browser", "phase": "runtime", "requires": ["artifact.next.static-export"], "provides": ["evidence.next.static-browser"], "commandIds": ["next.static-browser"]},
    {"id": "next.static-hydration", "phase": "runtime", "requires": ["artifact.next.static-export"], "provides": ["evidence.next.static-hydration"], "commandIds": ["next.static-hydration"]},
    {"id": "release.static-export", "phase": "release", "requires": ["evidence.lint", "evidence.next.client-boundary", "evidence.next.route-contract", "evidence.next.secret-boundary", "evidence.next.static-browser", "evidence.next.static-host-smoke", "evidence.next.static-hydration", "evidence.unit"], "provides": ["release.static-export"], "commandIds": []}
  ]
}
