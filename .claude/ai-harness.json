{
  "version": 1,
  "modes": [
    {
      "id": "AI_MODE",
      "description": "Generated content, retrieval, model-selected tools, or autonomous decisions",
      "requiredArtifacts": [
        "_workspace/01_plan/ai-requirements.md",
        "_workspace/01_plan/autonomy-risk-matrix.md",
        "_workspace/02_design/ai-architecture.md",
        "_workspace/02_design/tool-contracts.md",
        "_workspace/02_design/data-governance.md",
        "_workspace/02_design/ai-threat-model.md",
        "_workspace/02_design/eval-plan.md",
        "_workspace/02_design/cost-latency-budget.md"
      ]
    },
    {
      "id": "RAG_MODE",
      "description": "Retrieval-grounded answers over external or enterprise knowledge"
    },
    {
      "id": "TOOL_AGENT_MODE",
      "description": "Model-selected calls to internal or external systems"
    },
    {
      "id": "CODE_REVIEW_AGENT_MODE",
      "description": "SCM pull-request context and AI review findings"
    },
    {
      "id": "REALTIME_VOICE_MODE",
      "description": "Realtime audio, interruption, and voice handoff"
    },
    {
      "id": "ANALYTICS_AGENT_MODE",
      "description": "Governed metrics, semantic queries, charts, and insights"
    },
    {
      "id": "BROWSER_AGENT_MODE",
      "description": "Browser navigation or page actions selected by an agent"
    }
  ],
  "commonAgents": {
    "planning": [
      "ai-requirements-analyst",
      "ai-solution-architect",
      "data-governance-architect",
      "tool-contract-designer",
      "ai-threat-modeler",
      "ai-eval-designer"
    ],
    "implementation": [
      "developer"
    ],
    "verification": [
      "ai-eval-runner",
      "ai-security-reviewer",
      "cost-latency-verifier",
      "agent-trace-verifier",
      "data-access-verifier"
    ]
  },
  "services": [
    {
      "id": "code-review",
      "skill": "ai-code-review-bot",
      "builder": "developer",
      "modes": [
        "AI_MODE",
        "TOOL_AGENT_MODE",
        "CODE_REVIEW_AGENT_MODE"
      ],
      "minimumScenarios": 5
    },
    {
      "id": "enterprise-search",
      "skill": "enterprise-search-ai",
      "builder": "developer",
      "modes": [
        "AI_MODE",
        "RAG_MODE"
      ],
      "minimumScenarios": 5
    },
    {
      "id": "customer-support",
      "skill": "customer-support-ai",
      "builder": "developer",
      "modes": [
        "AI_MODE",
        "RAG_MODE",
        "TOOL_AGENT_MODE"
      ],
      "minimumScenarios": 5
    },
    {
      "id": "analytics-dashboard",
      "skill": "ai-analytics-dashboard",
      "builder": "developer",
      "modes": [
        "AI_MODE",
        "TOOL_AGENT_MODE",
        "ANALYTICS_AGENT_MODE"
      ],
      "minimumScenarios": 5
    },
    {
      "id": "browser-agent",
      "skill": "browser-agent",
      "builder": "developer",
      "modes": [
        "AI_MODE",
        "TOOL_AGENT_MODE",
        "BROWSER_AGENT_MODE"
      ],
      "minimumScenarios": 5
    }
  ],
  "toolContractRequiredFields": [
    "name",
    "description",
    "inputSchema",
    "sideEffect",
    "requiredScopes",
    "requiresApproval",
    "idempotencyRequired",
    "timeoutMs",
    "auditEvent"
  ],
  "testStages": [
    "baseline",
    "foundation",
    "routing",
    "services",
    "policy",
    "eval-contracts"
  ]
}
