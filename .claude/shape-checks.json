{
  "$comment": "산출물 형태 → 그 형태가 요구하는 검증. targetShapes가 배열이므로 요구 세트는 합집합이다. id는 evidence/{id}.json 파일명과 맞춘다. kind는 검증 방식이다 — static은 validate-shape-checks.mjs가 코드·매니페스트만으로 판정하고, runtime은 실행이 필요해 quality runner에 바인딩돼야 한다. implemented가 false면 **하네스가 아직 못 하는 것**이며 프로젝트 실패로 보고하지 않는다.",
  "schemaVersion": 2,
  "common": {
    "$comment": "형태와 무관하게 요구된다 — substrate 층에 대응한다.",
    "checks": [
      {
        "id": "quality.lint",
        "kind": "runtime",
        "implemented": true,
        "$comment": "어댑터 command로 이미 바인딩돼 있다"
      },
      {
        "id": "quality.typecheck",
        "kind": "runtime",
        "implemented": true
      },
      {
        "id": "quality.unit",
        "kind": "runtime",
        "implemented": true
      }
    ]
  },
  "shapes": {
    "web-app": {
      "checks": [
        {
          "id": "vite.build",
          "kind": "runtime",
          "implemented": true
        },
        {
          "id": "vite.browser",
          "kind": "runtime",
          "implemented": true
        }
      ]
    },
    "library": {
      "checks": [
        {
          "id": "pack.publish-metadata",
          "kind": "static",
          "implemented": true,
          "$comment": "name·version·license·진입점·files 허용목록·repository·private 여부를 매니페스트만으로 판정"
        },
        {
          "id": "lib.public-api",
          "kind": "static",
          "implemented": true,
          "$comment": "exports가 가리키는 파일이 실제로 존재하는가. 타입 진입점도 함께"
        },
        {
          "id": "pack.contents",
          "kind": "runtime",
          "implemented": false,
          "$comment": "npm pack --dry-run 실행이 필요하다. quality runner 바인딩 미구현"
        }
      ]
    },
    "cli": {
      "checks": [
        {
          "id": "cli.bin-entrypoint",
          "kind": "static",
          "implemented": true,
          "$comment": "bin이 가리키는 파일 존재·shebang·확장자를 정적으로 판정"
        },
        {
          "id": "cli.exit-codes",
          "kind": "runtime",
          "implemented": false,
          "$comment": "실제 실행해 0/1/2를 관측해야 한다. 정적 근사는 프록시라 하지 않는다"
        },
        {
          "id": "cli.stderr-errors",
          "kind": "runtime",
          "implemented": false,
          "$comment": "실행 시 에러가 stderr로 가는지 관측 필요"
        }
      ]
    }
  }
}
