{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://web-harness.local/schemas/web-core/adapter.schema.json",
  "title": "Web Harness Built-in Adapter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "supportLevel",
    "trust",
    "project",
    "runtime",
    "detection",
    "profileDefaults",
    "provides",
    "conflicts",
    "deploymentProviders",
    "deploymentTargets",
    "artifacts",
    "initialCapabilities",
    "targetCapabilities",
    "shapes"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "supportLevel": {
      "enum": [
        "certified",
        "compatible",
        "experimental"
      ]
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "source",
        "commandPolicy",
        "allowedExecutables",
        "environmentAllowlist"
      ],
      "properties": {
        "tier": {
          "const": "builtin"
        },
        "source": {
          "const": "web-harness-control-plane"
        },
        "commandPolicy": {
          "const": "argv-only"
        },
        "allowedExecutables": {
          "const": [
            "pnpm"
          ]
        },
        "environmentAllowlist": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "CI",
              "NODE_ENV",
              "NEXT_TELEMETRY_DISABLED"
            ]
          }
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "framework",
        "variant",
        "packageManager",
        "router",
        "rendering"
      ],
      "properties": {
        "framework": {
          "type": "string",
          "minLength": 1
        },
        "variant": {
          "type": "string",
          "minLength": 1
        },
        "packageManager": {
          "const": "pnpm"
        },
        "router": {
          "type": "string",
          "minLength": 1
        },
        "rendering": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "supported"
      ],
      "properties": {
        "primary": {
          "type": "string",
          "minLength": 1
        },
        "supported": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "detection": {
      "$ref": "#/$defs/detection"
    },
    "profileDefaults": {
      "$ref": "#/$defs/profileDefaults"
    },
    "provides": {
      "$ref": "#/$defs/stringSet"
    },
    "conflicts": {
      "$ref": "#/$defs/stringSet"
    },
    "deploymentProviders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "deploymentTargets"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "deploymentTargets": {
            "$ref": "#/$defs/stringSet"
          }
        }
      }
    },
    "deploymentTargets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "runtime",
          "requires",
          "conflicts"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "runtime": {
            "type": "string",
            "minLength": 1
          },
          "requires": {
            "$ref": "#/$defs/stringSet"
          },
          "conflicts": {
            "$ref": "#/$defs/stringSet"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "kind",
          "deploymentTargets"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "deploymentTargets": {
            "$ref": "#/$defs/stringSet"
          }
        }
      }
    },
    "initialCapabilities": {
      "$ref": "#/$defs/stringSet"
    },
    "targetCapabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "shapes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "description": "이 프로필이 쓰는 형태 카탈로그 키(.claude/shape-checks.json). commands·checks·tasks를 대신한다 — 검사와 그래프는 형태에서, 명령은 프로젝트 package.json script에서 도출한다(2026-08-27)."
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
    },
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allPackages",
        "anyPackages",
        "allPaths",
        "anyPaths",
        "forbiddenPackages",
        "forbiddenPaths"
      ],
      "properties": {
        "allPackages": {
          "$ref": "#/$defs/stringSet"
        },
        "anyPackages": {
          "$ref": "#/$defs/stringSet"
        },
        "allPaths": {
          "$ref": "#/$defs/stringSet"
        },
        "anyPaths": {
          "$ref": "#/$defs/stringSet"
        },
        "forbiddenPackages": {
          "$ref": "#/$defs/stringSet"
        },
        "forbiddenPaths": {
          "$ref": "#/$defs/stringSet"
        }
      }
    },
    "profileDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productKind",
        "backendShape",
        "deploymentProvider",
        "deploymentTarget",
        "riskLevel",
        "capabilities"
      ],
      "properties": {
        "productKind": {
          "type": "string",
          "minLength": 1
        },
        "backendShape": {
          "type": "string",
          "minLength": 1
        },
        "deploymentProvider": {
          "$ref": "#/$defs/id"
        },
        "deploymentTarget": {
          "$ref": "#/$defs/id"
        },
        "riskLevel": {
          "enum": [
            "public",
            "authenticated-business",
            "sensitive",
            "regulated"
          ]
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
