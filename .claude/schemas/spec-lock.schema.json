{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "spec-lock",
  "description": "개발 착수 전 확정된 구현 스팩. solution-design.md의 결정 블록을 검증·잠금한 결과이며 lock-spec.mjs stdout을 그대로 저장한다. 어떤 에이전트도 이 파일을 소유하지 않는다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "specTier",
    "acceptanceSource",
    "acceptanceRefs",
    "architecture",
    "layerMap",
    "libraries",
    "moduleBoundaries",
    "nonGoals",
    "decisions",
    "sourceDigest"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "specTier": {
      "enum": ["verifiable", "unverifiable"],
      "description": "verifiable = feature-plan의 수용 기준에 묶여 있다. unverifiable = 수용 기준이 없는 채로 잠겼다 — 설계는 확정됐으나 그것이 맞는지 판정할 기준이 없다."
    },
    "acceptanceSource": {"enum": ["feature-plan", "absent"]},
    "acceptanceRefs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "rationale"],
      "properties": {
        "pattern": {"type": "string", "minLength": 1, "description": "열린 문자열 — fsd·layered·domain-modules·existing·hexagonal 등"},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "layerMap": {
      "type": "object",
      "description": "논리 레이어 → 실제 경로. 레이어 이름과 경로 어휘를 둘 다 프로젝트가 정한다.",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "libraries": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["choice", "source"],
        "properties": {
          "choice": {"type": "string", "minLength": 1},
          "alternatives": {"type": "array", "items": {"type": "string"}},
          "source": {"enum": ["measured", "measured-absent", "proposed"]}
        }
      }
    },
    "moduleBoundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope", "rationale"],
        "properties": {
          "scope": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "nonGoals": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "decisions": {
      "type": "array",
      "description": "잠금 시점에 open이 하나라도 있으면 잠글 수 없다 — 스팩 확정이 착수 전제다.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "options": {"type": "array", "items": {"type": "string"}},
          "recommended": {"type": "string"},
          "status": {"enum": ["assumed", "confirmed"]}
        }
      }
    },
    "sourceDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputs", "combined"],
      "description": "잠금이 유래한 입력의 해시. 입력이 바뀌면 잠금은 stale이다.",
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "present"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "present": {"type": "boolean"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "combined": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
