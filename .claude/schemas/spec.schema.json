{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "spec-lock",
  "description": "개발 착수 전 확정된 구현 스팩. solution-design.md의 결정 블록을 검증·스팩 확정한 결과이며 spec.mjs stdout을 그대로 저장한다. 어떤 에이전트도 이 파일을 소유하지 않는다.",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "세대 2부터 testLayers를 요구한다. 세대 1(2026-08-28 이전 확정)은 그대로 유효하다 — 커밋된 증거를 새 규칙에 맞춰 고쳐 쓰지 않기 위한 마이그레이션이다.",
      "if": {"properties": {"schemaVersion": {"const": 2}}, "required": ["schemaVersion"]},
      "then": {"required": ["testLayers"]}
    }
  ],
  "required": [
    "schemaVersion",
    "specTier",
    "acceptanceSource",
    "acceptanceRefs",
    "constitution",
    "targetShapes",
    "architecture",
    "layerMap",
    "libraries",
    "moduleBoundaries",
    "nonGoals",
    "decisions",
    "sourceDigest"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [1, 2],
      "description": "2 = testLayers를 담는 세대(2026-08-28). 1은 그 이전에 확정된 스팩이며 읽기 전용 이력이다 — 이미 커밋된 증거에 결박된 스팩을 새 규칙에 맞춰 고쳐 쓰지 않는다. 신규 확정은 항상 2다."
    },
    "specTier": {
      "enum": [
        "verifiable",
        "unverifiable"
      ],
      "description": "verifiable = feature-plan의 수용 기준에 묶여 있다. unverifiable = 수용 기준이 없는 채로 잠겼다 — 설계는 확정됐으나 그것이 맞는지 판정할 기준이 없다."
    },
    "acceptanceSource": {
      "enum": [
        "feature-plan",
        "absent"
      ]
    },
    "acceptanceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern",
        "rationale"
      ],
      "properties": {
        "pattern": {
          "type": "string",
          "minLength": 1,
          "description": "열린 문자열 — fsd·layered·domain-modules·existing·hexagonal 등"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "layerMap": {
      "type": "object",
      "description": "논리 레이어 → 실제 경로. 레이어 이름과 경로 어휘를 둘 다 프로젝트가 정한다.",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "testLayers": {
      "type": "object",
      "description": "테스트가 놓일 경로. 개발 에이전트의 쓰기 소유권이 여기서 나온다. unit은 항상 필요하고(유닛 테스트는 형태와 무관하게 항상 수행한다), e2e는 targetShapes에 UI를 가진 형태가 있으면 필요하다(형태 카탈로그 shapes.<name>.userInterface에서 도출). layerMap과 별도인 이유: layerMap은 레이어 이름을 프로젝트가 정하므로 어느 레이어가 테스트인지 이름으로 맞히면 프록시가 된다. 경로가 layerMap 값과 겹쳐도 된다 — 유닛 테스트를 소스 옆에 두는 것이 정상이다.",
      "additionalProperties": false,
      "required": ["unit"],
      "properties": {
        "unit": {"type": "string", "minLength": 1},
        "e2e": {"type": "string", "minLength": 1}
      }
    },
    "libraries": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "choice",
          "source"
        ],
        "properties": {
          "choice": {
            "type": "string",
            "minLength": 1
          },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "enum": [
              "measured",
              "measured-absent",
              "inferred",
              "confirmed",
              "proposed"
            ],
            "description": "근거의 출처. measured=대상 코드·선언에서 실측. measured-absent=찾아보고 없음을 확인. inferred=사용자 요청에서 추론(그린필드의 기본 경로). confirmed=사용자가 직접 골랐다. proposed=설계자 제안이며 실측·추론·확인 어느 근거도 없다."
          }
        }
      }
    },
    "moduleBoundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope",
          "rationale"
        ],
        "properties": {
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "nonGoals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decisions": {
      "type": "array",
      "description": "확정 시점에 open이 하나라도 있으면 잠글 수 없다 — 스팩 확정이 착수 전제다.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recommended": {
            "type": "string"
          },
          "status": {
            "enum": [
              "assumed",
              "confirmed"
            ]
          }
        }
      }
    },
    "sourceDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputs",
        "combined"
      ],
      "description": "스팩이 유래한 입력의 해시. 입력이 바뀌면 스팩은 stale이다.",
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "present"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "present": {
                "type": "boolean"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "combined": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "constitution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "substrate"
      ],
      "description": "프로젝트 단위로 고정되는 것. 서비스마다 달라지는 유동 선택(architecture·libraries·communication 등)과 구분된다. 원칙 층(test-first·증거 요구·안전 하한)은 하네스 protected-core가 소유하며 여기서 재선언하지 않는다.",
      "properties": {
        "substrate": {
          "type": "object",
          "description": "도구 기반. 미지정 키는 하네스 기본값(.claude/substrate-defaults.json)으로 채워지고 source가 default로 기록된다.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "source"
            ],
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "enum": [
                  "default",
                  "measured",
                  "inferred",
                  "declared"
                ],
                "description": "default=하네스 기본값. measured=대상에서 실측. inferred=사용자 요청에서 추론. declared=사용자가 명시(rationale 필수)."
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "communication": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "통신 방식. rest·graphql·websocket·sse·streaming 등. 라이브러리가 아니라 접근 방식이라 libraries와 분리한다."
    },
    "concurrency": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "동시성 접근. web-worker·service-worker·worker-thread 등. 없으면 빈 배열."
    },
    "targetShapes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "산출물 형태. **배열이다** — 하나의 패키지가 라이브러리이면서 CLI인 것은 정상 패턴이다(exports + bin의 dual entry point). 형태가 다르면 검증도 다르므로 검사 세트는 선언된 형태의 **합집합**이 된다. web-app·library·cli 등 열린 문자열이며 예시일 뿐이다."
    }
  }
}
