{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "phase": {"type": "string", "enum": ["impact", "apply"]},
    "outcome": {"type": "string", "enum": ["READY", "ALREADY_APPLIED", "BLOCKED", "READY_FOR_REVIEW", "NO_CHANGE"]},
    "summary": {"type": "string", "maxLength": 8000},
    "affectedFiles": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 320}},
    "affectedFeatureIds": {"type": "array", "maxItems": 64, "items": {"type": "string", "pattern": "^FEAT-[0-9]{3,}$"}},
    "affectedSubFeatureIds": {"type": "array", "maxItems": 64, "items": {"type": "string", "pattern": "^FEAT-[0-9]{3,}-[0-9]{2}$"}},
    "affectedTestCaseIds": {"type": "array", "maxItems": 128, "items": {"type": "string", "pattern": "^TC-[0-9]{3,}-[0-9]+$"}},
    "sourceDigest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "previewDigest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "risks": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 1000}},
    "checks": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 1000}},
    "blockers": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 1000}}
  },
  "required": ["phase", "outcome", "summary", "affectedFiles", "affectedFeatureIds", "affectedSubFeatureIds", "affectedTestCaseIds", "sourceDigest", "previewDigest", "risks", "checks", "blockers"],
  "additionalProperties": false
}
